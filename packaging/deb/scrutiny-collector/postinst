#!/bin/sh
set -e

if [ "$1" = configure ] && command -v systemctl > /dev/null; then
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload
	fi
	# first install only, so an admin's disable survives upgrades
	if [ -z "$2" ]; then
		systemctl enable scrutiny-collector.timer
		if [ -d /run/systemd/system ]; then
			systemctl start scrutiny-collector.timer
		fi
	fi
fi
